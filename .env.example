# PrestaFacilito · plantilla de variables (las únicas que usa la app)
# Copiar a .env.local y completar. En Vercel: Settings → Environment Variables → Import .env

# Supabase (SUPABASE_KEY = clave SECRETA service_role, nunca la anon)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="PEGAR_AQUI_LA_CLAVE_SERVICE_ROLE"

# Acceso a la app
JWT_SECRET="un-secreto-largo-y-aleatorio"
PIN_SJAQUER="000000"
PIN_RJAQUE="000000"

# Google: Drive (respaldo y fuente de confianza) y Calendar (cobros)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN="PEGAR_AQUI_EL_REFRESH_TOKEN"
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_CLIENTES_FOLDER_ID=""
GOOGLE_CALENDAR_ID="primary"

# Archivos: normal = Storage + copia inmediata en Drive · solo_drive = si Storage colapsa
ARCHIVOS_MODO="normal"

# Cron de Vercel (respaldo semanal, calendario, restauración a Storage)
CRON_SECRET="un-secreto-largo-y-aleatorio"

# Opcionales (tienen valor por defecto): APP_URL, GOOGLE_DRIVE_RESPALDOS_FOLDER_ID, SUPABASE_STORAGE_BUCKET
