# PrestaFacilito · plantilla de variables de entorno
# Copia a `.env.local` (tiene prioridad sobre `.env`) y completa los valores. Nunca subir con valores reales.

# Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"
# Clave service_role (Settings → API). SECRETA: solo en el backend, nunca en el navegador.
# Con RLS activo, la clave anon no tiene acceso a nada.
SUPABASE_KEY="tu-service-role-key"
# Bucket privado de Storage para comprobantes y documentos (por defecto "archivos")
SUPABASE_STORAGE_BUCKET="archivos"
# Archivos: "normal" = Storage (carga rápida) + copia inmediata en Drive (fuente de confianza).
# "solo_drive" = si Storage colapsa: todo se guarda y se lee desde Drive; al volver a "normal" se restaura solo.
ARCHIVOS_MODO="normal"

# Google (Drive = copias de seguridad semanales, Calendar = cobros) via OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# Carpetas de respaldo en Drive. Si alguna se deja vacía, se crea una con nombre fijo en la raíz.
# Comprobantes (se organizan en subcarpetas AAAA-MM)
GOOGLE_DRIVE_FOLDER_ID="id-de-carpeta-para-comprobantes"
# Documentos de clientes (una subcarpeta "Documentos - <cliente>" por cliente)
GOOGLE_DRIVE_CLIENTES_FOLDER_ID="id-de-carpeta-para-documentos"
# Excel semanal
GOOGLE_DRIVE_RESPALDOS_FOLDER_ID="id-de-carpeta-para-excel"
# Calendario donde se crean los cobros. Recomendado: un calendario dedicado ("Cobros"), no el personal.
GOOGLE_CALENDAR_ID="id-del-calendario@group.calendar.google.com"
# URL pública de la app (para el enlace dentro de cada evento del calendario)
APP_URL="https://tu-app.vercel.app"
# Secreto para los cron de Vercel (/api/cron/calendario y /api/backup/cron). Genera uno largo y aleatorio.
CRON_SECRET=""
# Solo fuera de Vercel: sincronizar el calendario una vez al día desde server.ts
ENABLE_CALENDAR_CRON="false"

# Acceso: un PIN por usuario (PIN_<USUARIO>)
PIN_SJAQUER="1234"
PIN_RJAQUE="5678"
JWT_SECRET="un-secreto-muy-seguro-y-largo"
