# PrestaFacilito environment template
# No subir este archivo con valores reales. Copia a `.env` y completa los valores.

# Core APIs
GEMINI_API_KEY=""
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-anon-key-o-service-role-key"

# Google Integrations (Drive & Calendar) via OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID="id-de-carpeta-para-vouchers"
GOOGLE_DRIVE_CLIENTES_FOLDER_ID="id-de-carpeta-para-documentos-de-clientes"
# Calendario donde se crean los cobros. Recomendado: un calendario dedicado ("Cobros"), no el personal.
GOOGLE_CALENDAR_ID="id-del-calendario@group.calendar.google.com"
# URL pública de la app (para el enlace dentro de cada evento del calendario)
APP_URL="https://tu-app.vercel.app"
# Secreto para el cron diario de Vercel (/api/cron/calendario). Genera uno largo y aleatorio.
CRON_SECRET=""
# Solo fuera de Vercel: sincronizar el calendario una vez al día desde server.ts
ENABLE_CALENDAR_CRON="false"

# Authentication & Admins
ADMIN_USER="admin"
ADMIN_PASS="tu-password-segura-admin"
PIN_SJAQUER="1234"
PIN_RJAQUE="5678"
JWT_SECRET="un-secreto-muy-seguro-y-largo"
